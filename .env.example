# Copy to .env and fill in values. Do not commit .env.
# Supabase (Postgres + Auth) is external; obtain these from your Supabase project.

# Backend: Supabase Postgres (Connection string from Project Settings > Database)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Backend: Supabase Auth (Project Settings > API)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Backend: optional; docker-compose sets these when using Docker
# PORT=3000
# FRONTEND_URL=http://localhost:3000
# Production: set to CloudFront or custom domain (e.g. https://dusbh2m7p52nb.cloudfront.net). Comma-separated for multiple origins.
# CORS_DEBUG=true  # Log CORS headers on each response (for debugging)

# Frontend: optional; docker-compose sets when using Docker
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Frontend: Supabase (same project as backend)
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
