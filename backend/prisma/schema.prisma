// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String
  games     Game[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Statistics fields
  totalGamesPlayed                        Int     @default(0)
  averageScore                            Float   @default(0)
  bestScore                               Int?
  worstScore                              Int?
  totalWinnings                           Int     @default(0)
  totalCorrectAnswers                     Int     @default(0)
  totalIncorrectAnswers                   Int     @default(0)
  jeopardyCorrect                         Int     @default(0)
  jeopardyIncorrect                       Int     @default(0)
  doubleJeopardyCorrect                  Int     @default(0)
  doubleJeopardyIncorrect                Int     @default(0)
  finalJeopardyCorrect                   Int     @default(0)
  finalJeopardyIncorrect                 Int     @default(0)
  dailyDoubleCorrect                      Int     @default(0)
  dailyDoubleIncorrect                    Int     @default(0)
  currentCorrectStreak                    Int     @default(0)
  longestCorrectStreak                    Int     @default(0)
  currentIncorrectStreak                  Int     @default(0)
  longestIncorrectStreak                  Int     @default(0)
  largestSuccessfulDailyDoubleWager      Int?
  largestSuccessfulFinalJeopardyWager    Int?
  largestUnsuccessfulDailyDoubleWager     Int?
  largestUnsuccessfulFinalJeopardyWager  Int?
}

model Game {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  state GameState @default(PENDING)
  score Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gameClues     GameClue[]
  finalJeopardy FinalJeopardy?
  auditLogs     GameAudit[]
}

model Clue {
  id String @id @default(cuid())

  category    String
  round       Round
  value       Int
  question    String
  answer      String
  dailyDouble Boolean @default(false)

  createdAt DateTime @default(now())

  // IMPORTANT:
  // Clue records are immutable after creation.
  // No updates to question, answer, category, round, value, or dailyDouble.
  gameClues     GameClue[]      @relation("GameClueClue")
  finalJeopardy FinalJeopardy[] @relation("FinalJeopardyClue")

  // Index for efficient duplicate detection during ingestion
  @@index([round, category, question, answer])
}

model GameClue {
  id String @id @default(cuid())

  game   Game   @relation(fields: [gameId], references: [id])
  gameId String

  clue   Clue   @relation("GameClueClue", fields: [clueId], references: [id])
  clueId String

  state         ClueState @default(UNANSWERED)
  isDailyDouble Boolean   @default(false)

  // Only populated for Daily Doubles
  wager Int?

  // Score delta resulting from this clue resolution
  scoreDelta Int?

  answeredAt DateTime?
}

model FinalJeopardy {
  id String @id @default(cuid())

  game   Game   @relation(fields: [gameId], references: [id])
  gameId String @unique

  clue   Clue   @relation("FinalJeopardyClue", fields: [clueId], references: [id])
  clueId String

  wager      Int
  correct    Boolean?
  scoreDelta Int?
  answeredAt DateTime?
}

model GameAudit {
  id String @id @default(cuid())

  game   Game   @relation(fields: [gameId], references: [id])
  gameId String

  action  String
  details Json?

  createdAt DateTime @default(now())
}

enum GameState {
  PENDING // Created, board not yet played
  ACTIVE // Jeopardy / Double Jeopardy in progress
  FINAL_PENDING // Eligible for Final Jeopardy, wager not submitted
  FINAL_ACTIVE // Final Jeopardy in progress
  ELIMINATED // ≤ $0 after Double Jeopardy
  COMPLETED // Game finished
}

enum ClueState {
  UNANSWERED
  ANSWERED
  RESOLVED
}

enum Round {
  JEOPARDY
  DOUBLE_JEOPARDY
  FINAL
}
