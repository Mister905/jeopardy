# Copy to .env and fill in your Supabase project values.
# Required for production build. Get these from Supabase Dashboard → Project Settings → API.
# Use the exact names below (NEXT_PUBLIC_* is required for Next.js to expose them to the browser).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-jwt

# Optional: for local dev, backend is often http://localhost:3001
# NEXT_PUBLIC_API_URL=http://localhost:3001
