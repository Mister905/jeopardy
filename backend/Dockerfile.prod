# Production Dockerfile for NestJS backend (ECS/Fargate).
# Builds the app and runs node dist/main. Connects to Supabase Postgres via DATABASE_URL.

# Stage 1: build
FROM node:20-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npx prisma generate
RUN npm run build

# Stage 2: production
FROM node:20-alpine
ENV NODE_ENV=production
RUN apk add --no-cache wget
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/dist ./dist

EXPOSE 3000

CMD ["node", "dist/main"]
